# [!!!] Don't use the .env file, but use the inline environment variables (Taskfile / Docker / manually)

ENV=local|dev|prod|test

SERVICE_NAME=shortlink-analytics-api
SERVICE_VERSION=0.0.0

GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_IDLE_TIMEOUT=10s

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin
CLICKHOUSE_DB=shortlink
CLICKHOUSE_MAX_IDLE_CONNS=10
CLICKHOUSE_MAX_OPEN_CONNS=100
CLICKHOUSE_CONN_MAX_LIFETIME=5m
CLICKHOUSE_PING_TIMEOUT=1s
CLICKHOUSE_DIAL_TIMEOUT=5s
